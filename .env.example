# JWT Secret Key
JWT_SECRET=your-jwt-secret-key

# Cloudinary Configuration (for Product Images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# VNPay Configuration (for Payment)
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret

# Email Configuration (for Notifications)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Payment Return URL
PAYMENT_RETURN_URL=http://localhost:5173/payment-result

# Gemini API Key (for AI Chatbot - get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
